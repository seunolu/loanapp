}

/// @deprecated Legacy lender-loan penalty accrual table.
/// Canonical penalty accrual storage is TenantPenaltyAccrual.
model PenaltyAccrual {
  id             String        @id @default(cuid())
  loanId         String
  accrualDate    DateTime
  amountKobo     Int
  journalEntryId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  loan           Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, accrualDate])
  @@index([loanId, createdAt])
}

model WebhookEvent {
  id              String             @id @default(cuid())
  tenantId        String?
  provider        PaymentProvider
  eventType       String?
  providerEventId String?
  reference       String?
  signature       String?
  signatureValid  Boolean
  status          WebhookEventStatus @default(RECEIVED)
  payload         Json
  paymentId       String?
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  payment         Payment?           @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([tenantId, createdAt])
  @@index([provider, providerEventId])
  @@index([provider, eventType, createdAt])
  @@index([provider, reference, createdAt])
  @@index([status, createdAt])
  @@index([paymentId])
}

model LedgerAccount {
  id           String            @id @default(cuid())
  tenantId     String            @default("")
  code         String
  name         String
  type         LedgerAccountType
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  accountLines JournalLine[]     @relation("JournalLineAccount")
  lines        JournalLine[]     @relation("JournalLineLedgerAccount")

  @@unique([tenantId, code])
  @@index([type, isActive])
}

model JournalEntry {
  id              String          @id @default(cuid())
  tenantId        String          @default("")
  referenceType   String          @default("UNSPECIFIED")
  referenceId     String?
  description     String?
  createdBy       String?
  reference       String?
  requestId       String?
  postedAt        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  disbursement    Disbursement?
  lines           JournalLine[]
  penaltyAccruals PenaltyAccrual?
  repayments      Repayment?

  @@index([tenantId, createdAt])
  @@index([postedAt])
  @@index([reference])
  @@index([requestId])
}

model JournalLine {
  id              String          @id @default(cuid())
  tenantId        String          @default("")
  journalEntryId  String
  accountId       String?
  ledgerAccountId String
  debitMinor      Int             @default(0)
  creditMinor     Int             @default(0)
  entryType       JournalLineType
  amountKobo      Int
  description     String?
  createdAt       DateTime        @default(now())
  account         LedgerAccount?  @relation("JournalLineAccount", fields: [accountId], references: [id])
  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount   @relation("JournalLineLedgerAccount", fields: [ledgerAccountId], references: [id])

  @@index([tenantId, createdAt])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([ledgerAccountId])
  @@index([entryType])
}

