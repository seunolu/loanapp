generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  id             String            @id @default(cuid())
  key            String
  tenantId       String?
  scope          String?
  requestMethod  String
  requestPath    String
  requestHash    String
  status         IdempotencyStatus @default(PENDING)
  responseStatus Int?
  responseBody   Json?
  response       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([key, requestMethod, requestPath])
  @@unique([tenantId, scope, key])
  @@index([tenantId, scope, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  event      String
  action     String?
  status     AuditStatus @default(SUCCESS)
  summary    String?
  tenantId   String?
  lenderId   String?
  requestId  String?
  ip         String?
  userAgent  String?
  actorType  String?
  actorId    String?
  actorRole  String?
  entity     String?
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  error      Json?
  metadata   Json?
  createdAt  DateTime    @default(now())
  lender     Lender?     @relation(fields: [lenderId], references: [id])

  @@index([event])
  @@index([action])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([lenderId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@index([createdAt])
}

model AuditEvent {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  chainId          String
  sequence         Int
  hash             String
  prevHash         String?
  signatureVersion Int            @default(1)
  requestId        String?
  ipAddress        String?
  userAgent        String?
  actorType        AuditActorType
  actorId          String?
  actorRole        String?
  severity         AuditSeverity  @default(INFO)
  tenantId         String?
  lenderId         String?
  action           String
  resourceType     String?
  resourceId       String?
  entityType       String
  entityId         String
  beforeJson       Json?
  afterJson        Json?
  metadataJson     Json?
  diffJson         Json?
  idempotencyKey   String?        @unique

  @@unique([chainId, sequence])
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, resourceType, resourceId, createdAt])
  @@index([requestId])
}

model AuditChainState {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  chainId      String
  lastHash     String?
  lastSequence Int      @default(0)
  rotatedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SuspiciousActivity {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  reason     String
  severity   String
  createdAt  DateTime @default(now())
  resolved   Boolean  @default(false)
  resolvedBy String?

  @@index([tenantId, createdAt])
  @@index([tenantId, resolved, createdAt])
  @@index([tenantId, entityType, entityId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, key, enabled])
}

model NotificationLog {
  id        String              @id @default(cuid())
  event     String
  channel   NotificationChannel
  provider  String
  recipient String
  message   String
  status    NotificationStatus
  error     String?
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([event, createdAt])
  @@index([status, createdAt])
  @@index([recipient, createdAt])
}

model Notification {
  id             String                      @id @default(cuid())
  tenantId       String
  audienceType   NotificationAudienceType
  audienceUserId String
  channel        NotificationDeliveryChannel
  templateKey    String
  title          String
  body           String
  dataJson       Json
  status         NotificationRecordStatus    @default(QUEUED)
  idempotencyKey String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  readAt         DateTime?
  outbox         NotificationOutbox?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, audienceType, audienceUserId, createdAt])
  @@index([tenantId, createdAt])
}

model NotificationOutbox {
  id             String                   @id @default(cuid())
  tenantId       String
  notificationId String                   @unique
  status         NotificationOutboxStatus @default(PENDING)
  attempts       Int                      @default(0)
  lastError      String?
  nextAttemptAt  DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  notification   Notification             @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, nextAttemptAt])
}

model OutboxEvent {
  id               String    @id @default(cuid())
  tenantId         String
  aggregateType    String
  aggregateId      String
  eventType        String
  payload          Json
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?
  publishAttempts  Int       @default(0)
  lastPublishError String?
  traceId          String?
  causationId      String?
  correlationId    String?

  @@index([tenantId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
  @@index([publishedAt, createdAt])
}

model EventConsumerCheckpoint {
  id            String   @id @default(cuid())
  consumerName  String   @unique
  stream        String
  group         String
  lastMessageId String
  updatedAt     DateTime @updatedAt
}

model ProcessedEvent {
  id           String   @id @default(cuid())
  eventId      String
  consumerName String
  processedAt  DateTime @default(now())

  @@unique([eventId, consumerName])
  @@index([consumerName, processedAt])
}

model LoanApplicationReadModel {
  id              String   @id
  tenantId        String
  status          String
  createdAt       DateTime
  updatedAt       DateTime
  borrowerName    String?
  amountRequested Decimal? @db.Decimal(18, 2)
  amount          Int?
  tenorMonths     Int?
  productCode     String?
  riskBand        String?

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model Lender {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  status               LenderStatus           @default(ACTIVE)
  onboardingStatus     LenderOnboardingStatus @default(PENDING)
  onboardedAt          DateTime?
  settings             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  adminRoleAssignments AdminRoleAssignment[]
  admins               AdminUser[]
  auditLogs            AuditLog[]
  blacklistEntries     BlacklistEntry[]
  borrowers            Borrower[]
  borrowerNotes        BorrowerNote[]
  borrowerOverrides    BorrowerOverride[]
  borrowerRiskProfiles BorrowerRiskProfile[]
  dailyAggregates      DailyAggregate[]
  devices              Device[]
  disbursements        Disbursement[]
  kycCases             KycCase[]
  loans                Loan[]
  loanApplications     LoanApplication[]
  loanOffers           LoanOffer[]
  otpChallenges        OtpChallenge[]
  payments             Payment[]
  riskEvents           RiskEvent[]
  roles                Role[]
  underwritingCases    UnderwritingCase[]
}

model Tenant {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  name             String
  lenderTitle      String?
  apiBaseUrl       String?
  theme            Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  loanProducts     LoanProduct[]
  admins           TenantAdminUser[]
  loanApplications TenantLoanApplication[]
}

model TenantAdminUser {
  id                    String                       @id @default(cuid())
  tenantId              String
  email                 String
  passwordHash          String
  role                  TenantAdminRole              @default(CREDIT_OFFICER)
  isActive              Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  tenant                Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanApplicationEvents TenantLoanApplicationEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  tenantId    String
  lenderId    String?
  dedupeKey   String?   @unique
  payload     Json
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(10)
  lastError   String?
  backoffMs   Int       @default(5000)
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  succeededAt DateTime?
  failedAt    DateTime?

  @@index([status, runAt])
  @@index([tenantId, status, runAt])
  @@index([tenantId, type, dedupeKey])
}

model JobDlq {
  id          String   @id @default(cuid())
  tenantId    String
  jobId       String
  type        String
  payloadJson Json
  attempts    Int
  lastError   String
  failedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([jobId])
  @@index([tenantId, type, createdAt])
}

model SystemIntegritySnapshot {
  id                String                @id @default(cuid())
  tenantId          String
  checkedAt         DateTime              @default(now())
  totalLoansChecked Int
  failuresCount     Int
  status            SystemIntegrityStatus
  details           Json?

  @@index([tenantId, checkedAt])
  @@index([checkedAt])
}

model DailyAggregate {
  id                       String   @id @default(cuid())
  lenderId                 String
  date                     DateTime
  activeLoansCount         Int
  overdueLoansCount        Int
  principalOutstandingKobo Int
  totalOutstandingKobo     Int
  disbursedKobo            Int
  collectionsKobo          Int
  par1Kobo                 Int
  par7Kobo                 Int
  par30Kobo                Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  lender                   Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  @@unique([lenderId, date])
  @@index([date])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  lenderId   String
  otpRef     String    @unique
  phone      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  lender     Lender    @relation(fields: [lenderId], references: [id])

  @@index([lenderId])
  @@index([phone, createdAt])
  @@index([expiresAt])
}

model Borrower {
  id                    String                 @id @default(cuid())
  lenderId              String
  phone                 String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bankAccounts          BankAccount[]
  lender                Lender                 @relation(fields: [lenderId], references: [id])
  devices               BorrowerDevice[]
  notes                 BorrowerNote[]
  override              BorrowerOverride?
  profile               BorrowerProfile?
  riskProfile           BorrowerRiskProfile?
  consents              ConsentRecord[]
  trackedDevices        Device[]               @relation("BorrowerTrackedDevices")
  files                 File[]
  identityVerifications IdentityVerification[]
  kycCase               KycCase?
  loans                 Loan[]
  loanApplications      LoanApplication[]
  loanOffers            LoanOffer[]
  mandates              Mandate[]
  payments              Payment[]
  riskEvents            RiskEvent[]
  sessions              Session[]
  underwritingCases     UnderwritingCase[]
  userConsents          UserConsent[]

  @@unique([lenderId, phone])
  @@index([lenderId])
}

model Device {
  id          String      @id @default(cuid())
  lenderId    String
  borrowerId  String?
  deviceId    String
  ip          String?
  userAgent   String?
  fingerprint String?
  lastSeenAt  DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  borrower    Borrower?   @relation("BorrowerTrackedDevices", fields: [borrowerId], references: [id])
  lender      Lender      @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  riskEvents  RiskEvent[]

  @@unique([lenderId, deviceId])
  @@index([borrowerId, lastSeenAt])
}

model BorrowerRiskProfile {
  id              String    @id @default(cuid())
  lenderId        String
  borrowerId      String    @unique
  score           Int       @default(0)
  level           RiskLevel @default(LOW)
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  borrower        Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  lender          Lender    @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  @@index([lenderId, level])
}

model BlacklistEntry {
  id        String             @id @default(cuid())
  lenderId  String?
  type      BlacklistEntryType
  value     String
  reason    String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  lender    Lender?            @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  @@unique([lenderId, type, value])
  @@index([type, value, isActive])
}

model RiskEvent {
  id         String    @id @default(cuid())
  lenderId   String
  borrowerId String?
  deviceId   String?
  eventType  String
  scoreDelta Int
  totalScore Int
  level      RiskLevel
  blocked    Boolean   @default(false)
  reason     String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])
  device     Device?   @relation(fields: [deviceId], references: [id])
  lender     Lender    @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  @@index([lenderId, createdAt])
  @@index([borrowerId, createdAt])
  @@index([eventType, createdAt])
}

model BorrowerNote {
  id          String    @id @default(cuid())
  lenderId    String
  borrowerId  String
  note        String
  createdById String
  createdAt   DateTime  @default(now())
  borrower    Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  createdBy   AdminUser @relation(fields: [createdById], references: [id])
  lender      Lender    @relation(fields: [lenderId], references: [id])

  @@index([lenderId, borrowerId, createdAt])
  @@index([createdById])
}

model BorrowerOverride {
  id           String    @id @default(cuid())
  lenderId     String
  borrowerId   String    @unique
  maxLoanKobo  Int?
  maxTenorDays Int?
  updatedById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  borrower     Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  lender       Lender    @relation(fields: [lenderId], references: [id])
  updatedBy    AdminUser @relation(fields: [updatedById], references: [id])

  @@index([lenderId, borrowerId])
}

model BorrowerDevice {
  id         String    @id @default(cuid())
  borrowerId String
  deviceId   String
  platform   String?
  deviceName String?
  lastSeenAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  borrower   Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  sessions   Session[]

  @@unique([borrowerId, deviceId])
  @@index([borrowerId])
}

model Session {
  id               String          @id @default(cuid())
  borrowerId       String
  borrowerDeviceId String?
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  borrowerDevice   BorrowerDevice? @relation(fields: [borrowerDeviceId], references: [id])
  borrower         Borrower        @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([borrowerId])
  @@index([borrowerDeviceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model BorrowerProfile {
  id           String   @id @default(cuid())
  borrowerId   String   @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       String?
  addressLine1 String?
  city         String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  borrower     Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id         String   @id @default(cuid())
  borrowerId String
  type       String
  version    String
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?
  metadata   Json?
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@unique([borrowerId, type, version])
  @@index([borrowerId, acceptedAt])
}

model IdentityVerification {
  id                 String             @id @default(cuid())
  lenderId           String
  userId             String
  provider           String
  bvnHash            String?
  ninHash            String?
  verifiedName       String?
  verifiedDob        DateTime?
  verificationStatus VerificationStatus
  matchScore         Float?
  riskFlags          Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               Borrower           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lenderId, userId, createdAt])
  @@index([lenderId, verificationStatus, createdAt])
  @@index([lenderId, bvnHash])
}

model UserConsent {
  id         String   @id @default(cuid())
  lenderId   String
  userId     String
  type       String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())
  user       Borrower @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lenderId, userId, acceptedAt])
  @@index([lenderId, type, acceptedAt])
}

model File {
  id           String        @id @default(cuid())
  borrowerId   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  purpose      String
  storageKey   String        @unique
  status       FileStatus    @default(PENDING)
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  borrower     Borrower      @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  kycDocuments KycDocument[]

  @@index([borrowerId, status])
}

model KycCase {
  id          String        @id @default(cuid())
  lenderId    String
  borrowerId  String        @unique
  status      KycCaseStatus @default(PENDING)
  submittedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  borrower    Borrower      @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  lender      Lender        @relation(fields: [lenderId], references: [id])
  documents   KycDocument[]

  @@index([lenderId])
}

model KycDocument {
  id        String   @id @default(cuid())
  kycCaseId String
  fileId    String
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id])
  kycCase   KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)

  @@unique([kycCaseId, fileId])
  @@index([fileId])
}

model AdminUser {
  id                       String                @id @default(cuid())
  lenderId                 String?
  email                    String
  passwordHash             String?
  passwordSetAt            DateTime?
  role                     AdminRole
  status                   AdminStatus           @default(ACTIVE)
  lastLoginAt              DateTime?
  lastLoginIp              String?
  lastUserAgent            String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  inviteTokens             AdminInviteToken[]
  roleAssignment           AdminRoleAssignment?  @relation("AdminUserAssignedRole")
  assignedRoleAssignments  AdminRoleAssignment[] @relation("AdminUserRoleAssignedBy")
  sessions                 AdminSession[]
  lender                   Lender?               @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  borrowerNotes            BorrowerNote[]
  borrowerOverridesUpdated BorrowerOverride[]
  disbursementsInitiated   Disbursement[]
  underwritingCasesDecided UnderwritingCase[]

  @@unique([lenderId, email])
  @@index([lenderId])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Role {
  id          String                @id @default(cuid())
  lenderId    String
  name        String
  description String?
  isSystem    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments AdminRoleAssignment[]
  lender      Lender                @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([lenderId, name])
  @@index([lenderId, createdAt])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AdminRoleAssignment {
  id           String     @id @default(cuid())
  lenderId     String
  adminUserId  String     @unique
  roleId       String
  assignedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  adminUser    AdminUser  @relation("AdminUserAssignedRole", fields: [adminUserId], references: [id], onDelete: Cascade)
  assignedBy   AdminUser? @relation("AdminUserRoleAssignedBy", fields: [assignedById], references: [id])
  lender       Lender     @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([lenderId, adminUserId])
  @@index([lenderId, roleId])
}

model AdminInviteToken {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model AdminSession {
  id               String    @id @default(cuid())
  adminUserId      String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model LoanApplication {
  id               String                @id @default(cuid())
  lenderId         String
  borrowerId       String
  amountRequested  Int
  tenorDays        Int
  status           LoanApplicationStatus @default(SUBMITTED)
  submittedAt      DateTime              @default(now())
  reviewedAt       DateTime?
  reviewReason     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  borrower         Borrower              @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  lender           Lender                @relation(fields: [lenderId], references: [id])
  offer            LoanOffer?
  underwritingCase UnderwritingCase?

  @@index([lenderId, status])
  @@index([borrowerId, status])
  @@index([createdAt])
}

model TenantLoanApplication {
  id                        String                                 @id @default(cuid())
  tenantId                  String
  status                    TenantLoanApplicationStatus            @default(SUBMITTED)
  principal                 Decimal                                @default(0) @db.Decimal(18, 2)
  currency                  String                                 @default("NGN")
  annualInterestRateBps     Int                                    @default(0)
  termInDays                Int                                    @default(0)
  repaymentFrequency        RepaymentFrequency                     @default(MONTHLY)
