  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  allocations            RepaymentAllocation[]

  @@index([loanId, createdAt])
}

model RepaymentAllocation {
  id          String                  @id @default(cuid())
  repaymentId String
  bucket      RepaymentAllocationType
  amountKobo  Int
  createdAt   DateTime                @default(now())
  repayment   Repayment               @relation(fields: [repaymentId], references: [id], onDelete: Cascade)

  @@index([repaymentId])
  @@index([bucket])
}

/// @deprecated Legacy lender-loan penalty accrual table.
/// Canonical penalty accrual storage is TenantPenaltyAccrual.
model PenaltyAccrual {
  id             String       @id @default(cuid())
  loanId         String
  accrualDate    DateTime
  amountKobo     Int
  journalEntryId String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  loan           Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([loanId, accrualDate])
  @@index([loanId, createdAt])
}

model WebhookEvent {
  id             String             @id @default(cuid())
  tenantId       String?
  provider       PaymentProvider
  eventType      String?
  providerEventId String?
  reference      String?
  signature      String?
  signatureValid Boolean
  status         WebhookEventStatus @default(RECEIVED)
  payload        Json
  paymentId      String?
  processedAt    DateTime?
  processingError String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([provider, providerEventId])
  @@index([provider, eventType, createdAt])
  @@index([provider, reference, createdAt])
  @@index([status, createdAt])
  @@index([paymentId])
  @@unique([provider, providerEventId])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  tenantId  String            @default("")
  code      String
  name      String
  type      LedgerAccountType
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  lines     JournalLine[]      @relation("JournalLineLedgerAccount")
  accountLines JournalLine[]   @relation("JournalLineAccount")

  @@unique([tenantId, code])
  @@index([type, isActive])
}

model JournalEntry {
  id            String        @id @default(cuid())
  tenantId      String        @default("")
  referenceType String        @default("UNSPECIFIED")
  referenceId   String?
  description   String?
  createdBy     String?
  reference     String?
  requestId     String?
  postedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  lines         JournalLine[]
  disbursement  Disbursement?
  repayments    Repayment[]
  penaltyAccruals PenaltyAccrual[]

  @@index([tenantId, createdAt])
  @@index([postedAt])
  @@index([reference])
  @@index([requestId])
}

model JournalLine {
  id              String          @id @default(cuid())
  tenantId        String          @default("")
  journalEntryId  String
  accountId       String?
  ledgerAccountId String
  debitMinor      Int             @default(0)
  creditMinor     Int             @default(0)
  entryType       JournalLineType
  amountKobo      Int
  description     String?
  createdAt       DateTime        @default(now())
  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         LedgerAccount?  @relation("JournalLineAccount", fields: [accountId], references: [id])
  ledgerAccount   LedgerAccount   @relation("JournalLineLedgerAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([ledgerAccountId])
  @@index([entryType])
}

