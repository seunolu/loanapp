{
  "name": "@loanapp/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "android": "expo run:android",
    "eas:build:android:demo": "eas build --platform android --profile production-demo",
    "eas:build:android:acme": "eas build --platform android --profile production-acme",
    "eas:build:android:custom": "eas build --platform android --profile production-custom",
    "eas:build:ios:demo": "eas build --platform ios --profile production-demo",
    "eas:build:ios:acme": "eas build --platform ios --profile production-acme",
    "eas:build:ios:custom": "eas build --platform ios --profile production-custom",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm lint && pnpm typecheck",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@tanstack/react-query": "^5.66.8",
    "expo": "^52.0.20",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-linking": "~7.0.5",
    "expo-router": "^4.0.19",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.0",
    "typescript": "^5.7.2"
  }
}
